  if(btn){ btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> 발송 중...'; }

  try {
    // TODO: 이메일 API 연동 시 이 위치에 API 호출 코드 삽입
    // API 연동 전까지는 이력 저장만 처리
    await _saveDispatchRecord({
      method    : '이메일',
      status    : '완료',
      recipient : email,
      note      : `수신 이메일: ${email}`,
    });
