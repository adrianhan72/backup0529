            color: '#999',
            callback: val => {
              if(val >= 1000000) return (val / 1000000).toFixed(1) + '백만';
              if(val >= 10000)   return (val / 10000).toFixed(0) + '만';
              return Math.round(val).toLocaleString('ko-KR');
            }
          }
        }
      }
    }
  });
}
